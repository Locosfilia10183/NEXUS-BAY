[Unit]
Description=NEXUS-BAY Lobby (Paper)
After=network-online.target nexus-bay-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=nexusbay
Group=nexusbay
WorkingDirectory=/opt/nexus-bay/servers/lobby
ExecStart=/opt/nexus-bay/servers/lobby/start.sh
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/nexus-bay/servers/lobby /opt/nexus-bay/logs

[Install]
WantedBy=multi-user.target
